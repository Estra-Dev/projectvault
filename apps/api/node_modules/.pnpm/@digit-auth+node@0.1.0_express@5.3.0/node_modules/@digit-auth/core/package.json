{
  "name": "@digit-auth/core",
  "version": "0.1.0",
  "private": false,
  "description": "Shared contracts for the DigitAuth authentication platform.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Estra-Dev/digit-auth.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Estra-Dev/digit-auth/issues"
  },
  "homepage": "https://github.com/Estra-Dev/digit-auth#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "authentication",
    "authorization",
    "digit-auth",
    "core"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "pack:check": "pnpm build && pnpm pack --dry-run"
  }
}