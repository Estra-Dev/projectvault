{
  "name": "@digit-auth/node",
  "version": "0.1.0",
  "private": false,
  "description": "Node.js and Express SDK for DigitAuth authentication and authorization.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Estra-Dev/digit-auth.git",
    "directory": "packages/sdk-node"
  },
  "bugs": {
    "url": "https://github.com/Estra-Dev/digit-auth/issues"
  },
  "homepage": "https://github.com/Estra-Dev/digit-auth#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "authentication",
    "authorization",
    "express",
    "node",
    "sdk",
    "digit-auth"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@digit-auth/core": "^0.1.0"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "pack:check": "pnpm build && pnpm pack --dry-run"
  }
}